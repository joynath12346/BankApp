{
  "entities": {
    "BankAccount": {
      "title": "BankAccount",
      "description": "Customer banking portfolio deposit account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accountNumber": { "type": "string" },
        "routingNumber": { "type": "string" },
        "swiftBic": { "type": "string" },
        "accountHolderName": { "type": "string" },
        "accountHolderEmail": { "type": "string" },
        "accountHolderPhone": { "type": "string" },
        "companyName": { "type": "string" },
        "type": { "type": "string", "enum": ["checking", "savings", "business_checking", "money_market", "treasury_escrow"] },
        "currency": { "type": "string", "enum": ["USD", "EUR", "GBP", "JPY", "CAD"] },
        "balance": { "type": "number" },
        "availableBalance": { "type": "number" },
        "holdBalance": { "type": "number" },
        "overdraftLimit": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "frozen", "dormant", "restricted"] },
        "kycTier": { "type": "number" },
        "openedDate": { "type": "string" },
        "branchCode": { "type": "string" },
        "interestRateAnnual": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["accountNumber", "accountHolderName", "type", "currency", "balance", "status"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Interbank clearing ledger journal record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "accountId": { "type": "string" },
        "accountNumber": { "type": "string" },
        "accountHolderName": { "type": "string" },
        "targetAccountId": { "type": "string" },
        "targetAccountNumber": { "type": "string" },
        "counterpartyName": { "type": "string" },
        "counterpartyBank": { "type": "string" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "direction": { "type": "string", "enum": ["credit", "debit"] },
        "timestamp": { "type": "string" },
        "status": { "type": "string", "enum": ["settled", "pending", "flagged", "reversed"] },
        "riskScore": { "type": "number" },
        "fee": { "type": "number" },
        "memo": { "type": "string" },
        "amlNotes": { "type": "string" }
      },
      "required": ["referenceNumber", "accountId", "accountNumber", "counterpartyName", "amount", "direction", "status"]
    },
    "LoanApplication": {
      "title": "LoanApplication",
      "description": "Commercial and retail credit facility record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "loanNumber": { "type": "string" },
        "applicantName": { "type": "string" },
        "applicantEmail": { "type": "string" },
        "accountId": { "type": "string" },
        "accountNumber": { "type": "string" },
        "loanType": { "type": "string" },
        "requestedAmount": { "type": "number" },
        "approvedAmount": { "type": "number" },
        "termMonths": { "type": "number" },
        "interestRate": { "type": "number" },
        "monthlyPayment": { "type": "number" },
        "creditScore": { "type": "number" },
        "dtiRatio": { "type": "number" },
        "collateralDescription": { "type": "string" },
        "collateralValue": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "purpose": { "type": "string" },
        "totalPaid": { "type": "number" },
        "remainingBalance": { "type": "number" }
      },
      "required": ["loanNumber", "applicantName", "accountId", "requestedAmount", "status"]
    },
    "BankCard": {
      "title": "BankCard",
      "description": "Payment card issued to customer account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accountId": { "type": "string" },
        "accountNumber": { "type": "string" },
        "cardholderName": { "type": "string" },
        "cardNumberMasked": { "type": "string" },
        "fullCardNumberVirtual": { "type": "string" },
        "expMonth": { "type": "string" },
        "expYear": { "type": "string" },
        "cvv": { "type": "string" },
        "pin": { "type": "string" },
        "tier": { "type": "string" },
        "cardBrand": { "type": "string" },
        "status": { "type": "string" },
        "dailyLimit": { "type": "number" },
        "spentToday": { "type": "number" },
        "internationalAllowed": { "type": "boolean" },
        "atmWithdrawalAllowed": { "type": "boolean" },
        "onlineAllowed": { "type": "boolean" },
        "contactlessAllowed": { "type": "boolean" },
        "issuedDate": { "type": "string" }
      },
      "required": ["accountId", "cardholderName", "cardNumberMasked", "status"]
    },
    "AmlAlert": {
      "title": "AmlAlert",
      "description": "Anti-money laundering compliance flagged incident",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "transactionId": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "accountId": { "type": "string" },
        "accountNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "severity": { "type": "string" },
        "flagType": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "flaggedAt": { "type": "string" },
        "status": { "type": "string" },
        "assignedTo": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["accountId", "customerName", "severity", "description", "status"]
    },
    "BranchVault": {
      "title": "BranchVault",
      "description": "Physical cash vault reconciliation state",
      "type": "object",
      "properties": {
        "branchName": { "type": "string" },
        "branchCode": { "type": "string" },
        "vaultCashUSD": { "type": "number" },
        "tellerDrawersCashUSD": { "type": "number" },
        "reserveRequirementRatio": { "type": "number" },
        "centralBankDepositUSD": { "type": "number" },
        "lastAuditedAt": { "type": "string" },
        "dailyEodReconciled": { "type": "boolean" },
        "auditorName": { "type": "string" }
      },
      "required": ["branchCode", "vaultCashUSD"]
    }
  },
  "firestore": {
    "/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/BankAccount" },
      "description": "Collection of customer deposit and escrow accounts"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Interbank clearing ledger records"
    },
    "/loans/{loanId}": {
      "schema": { "$ref": "#/entities/LoanApplication" },
      "description": "Loan facilities and credit applications"
    },
    "/cards/{cardId}": {
      "schema": { "$ref": "#/entities/BankCard" },
      "description": "Issued credit and debit cards"
    },
    "/aml_alerts/{alertId}": {
      "schema": { "$ref": "#/entities/AmlAlert" },
      "description": "AML risk surveillance alerts"
    },
    "/vault/{vaultId}": {
      "schema": { "$ref": "#/entities/BranchVault" },
      "description": "Branch physical vault cash reserves"
    }
  }
}
